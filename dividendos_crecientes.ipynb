   "source": [
    "import yfinance as yf\n",
    "\n",
    "ticker = yf.Ticker(\"AAPL\")\n",
    "info = ticker.info\n",
    "\n",
    "# Extraer datos específicos\n",
    "eps = info.get(\"trailingEps\")\n",
    "market_cap = info.get(\"marketCap\")\n",
    "sector = info.get(\"sector\")\n",
    "\n",
    "print(f\"EPS: {eps} | Market Cap: {market_cap} | Sector: {sector}\")"
   ]
  }
 ],
